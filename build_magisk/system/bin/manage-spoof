#!/system/bin/sh
# manage-spoof: Gestiona el alcance (scope) del spoofing de LSPosed (Wi-Fi y Sensores)
DB="/data/adb/lspd/config/modules_config.db"
MID=$(sqlite3 "$DB" "SELECT mid FROM modules WHERE module_pkg_name='eu.chylek.adam.fakewifi';" 2>/dev/null)
if [ -z "$MID" ]; then
    MID=39
fi


# Asegurar privilegios root
if [ "$(id -u)" != "0" ]; then
    exec su -c "$0 $*"
fi

case "$1" in
    list|status)
        echo "=== Apps con Spoofing Activo (Scope) ==="
        sqlite3 "$DB" "SELECT app_pkg_name FROM scope WHERE mid=$MID;" 2>/dev/null
        ;;
    add)
        if [ -z "$2" ]; then
            echo "Uso: manage-spoof add <nombre.del.paquete>"
            exit 1
        fi
        sqlite3 "$DB" "INSERT OR REPLACE INTO scope (mid, app_pkg_name, user_id) VALUES ($MID, '$2', 0);" 2>/dev/null
        echo "[+] Spoofing de LSPosed activado para: $2"
        ;;
    remove|rm)
        if [ -z "$2" ]; then
            echo "Uso: manage-spoof remove <nombre.del.paquete>"
            exit 1
        fi
        sqlite3 "$DB" "DELETE FROM scope WHERE mid=$MID AND app_pkg_name='$2';" 2>/dev/null
        echo "[-] Spoofing removido para: $2"
        ;;
    sync|all-browsers|auto)
        # Scope dinámico (B6): todas las apps de usuario instaladas + la lista
        # curada de paquetes de sistema. Cualquier app nueva (Play, adb, tienda
        # stub del manager) entra sola en el próximo arranque: apply-props.sh
        # invoca esto en cada boot. Reemplaza la lista fija original, que se
        # quedaba desactualizada y dejaba apps fuera de scope (fuga de Build).
        if ! sqlite3 -cmd ".timeout 5000" "$DB" "SELECT 1;" >/dev/null 2>&1; then
            echo "[!] sqlite3 no disponible en este contexto (¿docker exec?); usar adb."
            exit 1
        fi
        SYS_TARGETS="com.android.settings com.android.vending com.google.android.gms com.google.android.googlequicksearchbox"
        EXCLUDE="org.lsposed.manager"
        SNAP_B="/data/local/tmp/.proteomesh_scope_before"
        SNAP_A="/data/local/tmp/.proteomesh_scope_after"
        sqlite3 -cmd ".timeout 5000" "$DB" "SELECT app_pkg_name FROM scope WHERE mid=$MID ORDER BY 1;" > "$SNAP_B" 2>/dev/null
        PREV_LOST=$(grep -vxF -f "$SNAP_B" /data/local/tmp/.proteomesh_scope_prev 2>/dev/null)
        if [ -n "$PREV_LOST" ]; then
            echo "[i] $(date '+%m-%d %H:%M:%S') perdidas desde el arranque anterior:"
            echo "$PREV_LOST" | sed 's/^/    - /'
        fi
        ADDED=0
        for pkg in $(pm list packages -3 2>/dev/null | sed 's/^package://') $SYS_TARGETS; do
            [ "$pkg" = "$EXCLUDE" ] && continue
            # INSERT OR IGNORE + changes() en una sola conexión: atómico y a
            # prueba de locks (lspd tiene la DB abierta en WAL durante el boot;
            # un SELECT de existencia separado puede dar falso negativo y
            # generar marcadores de reinicio espurios).
            CH=$(sqlite3 -cmd ".timeout 5000" "$DB" \
                "INSERT OR IGNORE INTO scope (mid, app_pkg_name, user_id) VALUES ($MID, '$pkg', 0); SELECT changes();" 2>/dev/null)
            if [ "$CH" = "1" ]; then
                ADDED=$((ADDED+1))
                echo "  -> Activado para: $pkg"
            fi
        done
        TOTAL=$(sqlite3 -cmd ".timeout 5000" "$DB" "SELECT COUNT(*) FROM scope WHERE mid=$MID;" 2>/dev/null)
        sqlite3 -cmd ".timeout 5000" "$DB" "SELECT app_pkg_name FROM scope WHERE mid=$MID ORDER BY 1;" > "$SNAP_A" 2>/dev/null
        echo "[i] $(date '+%m-%d %H:%M:%S') antes=$(wc -l < "$SNAP_B") despues=$TOTAL"
        NEW_ROWS=$(grep -vxF -f "$SNAP_B" "$SNAP_A" 2>/dev/null)
        if [ -n "$NEW_ROWS" ]; then
            echo "[i] filas nuevas:"
            echo "$NEW_ROWS" | sed 's/^/    + /'
        fi
        LOST_ROWS=$(grep -vxF -f "$SNAP_A" "$SNAP_B" 2>/dev/null)
        if [ -n "$LOST_ROWS" ]; then
            echo "[i] filas perdidas:"
            echo "$LOST_ROWS" | sed 's/^/    - /'
        fi
        cp "$SNAP_A" /data/local/tmp/.proteomesh_scope_prev 2>/dev/null
        echo "[✓] Scope sincronizado: $ADDED nuevas (total $TOTAL)."
        if [ "$ADDED" -gt 0 ]; then
            # lspd cachea el scope al arrancar: la bandera hace que
            # instance_manager.py reinicie el contenedor una vez para aplicarlo.
            touch /data/local/tmp/.proteomesh_scope_updated 2>/dev/null || true
            echo "[i] Reinicio pendiente para aplicar el scope nuevo."
        fi
        ;;
    *)
        echo "Uso: manage-spoof {list|add <pkg>|remove <pkg>|sync}"
        ;;
esac
