#!/system/bin/sh
# ==============================================================================
# set-device-profile: Wrapper CLI para el cargador de perfiles de ProteoMesh
# En la arquitectura desacoplada (ADR-001 F1.5), delega exclusivamente en
# /system/bin/profile-loader sin fallbacks a modelos específicos.
# ==============================================================================

if [ -x "/system/bin/profile-loader" ]; then
    exec /system/bin/profile-loader "$@"
else
    echo "[!] ERROR FATAL: /system/bin/profile-loader no está disponible en el sistema." >&2
    exit 1
fi
