# ==============================================================================
# ProteoMesh — Git Ignore Rules
# ==============================================================================

# Android persistent and runtime data
data-clean/
data-s21/
data-*/
data/
instances/*/data/
instances/*/data/**

# Heavy GApps and APK bundles (> 100 MB, violates GitHub limits)
apk/
build_gapps/

# Temporary and build artifacts
*.log
!tests/results/f05-live/f05-rdp-clean-license-blocked.log
*.tmp
*.bak
*.orig
__pycache__/
*.py[cod]
.cache/
.probe/
build/tests/

# Sonda ashmem on-device (salidas de build)
tests/ashmem/device/ashmem_probe.apk
tests/ashmem/device/base.apk
tests/ashmem/device/unsigned.apk
tests/ashmem/device/classes/
tests/ashmem/device/dex/
tests/ashmem/device/tools/

# Sonda archprobe on-device (salidas de build)
tests/archprobe/device/arch_probe.apk
tests/archprobe/device/base.apk
tests/archprobe/device/unsigned.apk
tests/archprobe/device/classes/
tests/archprobe/device/dex/
tests/archprobe/device/tools/

# Web frontend build and dependencies
web/node_modules/
web/dist/
web/.vite/

# IDE and OS metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
.agents/
.venv/
skills-lock.json
genfarmer_install.sh
*.swp
*~
